# =============================================================================
# Knowledge Graph Pipeline - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys (Required)
# -----------------------------------------------------------------------------

# OpenAI API Key - Required for triplet extraction (o4-mini), enhancement, exploration
OPENAI_API_KEY=sk-...

# Google Gemini API Key - Required for PDF figure analysis
GEMINI_API_KEY=...

# Voyage AI API Key - Required for embedding generation
VOYAGE_API_KEY=pa-...

# LLMWhisperer API Key - Required for PDF text extraction
LLMWHISPERER_API_KEY=...

# -----------------------------------------------------------------------------
# Neo4j Database Configuration (Required)
# -----------------------------------------------------------------------------

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# For Aura DB (cloud), use format:
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io

# -----------------------------------------------------------------------------
# Directory Paths (Optional - defaults shown)
# -----------------------------------------------------------------------------

# Base data directory
DATA_DIR=./data

# Output directory for results
OUTPUT_DIR=./output

# Stage-specific paths
PDF_INPUT_DIR=./data/pdfs
CONVERTED_TEXT_DIR=./data/converted
CHUNKS_DIR=./data/chunks
TRIPLETS_DIR=./data/triplets
MERGED_JSON_PATH=./data/merged.json
EMBEDDINGS_PATH=./data/embeddings.npy
SIMILARITY_EDGES_PATH=./data/similarity_edges.json
ENHANCED_RELATIONSHIPS_PATH=./data/enhanced_relationships.json
CLEANED_RELATIONSHIPS_PATH=./data/enhanced_relationships_cleaned.json

# -----------------------------------------------------------------------------
# Model Configuration (Optional - defaults shown)
# -----------------------------------------------------------------------------

# PDF Conversion
GEMINI_MODEL=gemini-2.5-flash
PDF_DPI=300
PDF_TIMEOUT=300

# Triplet Extraction
EXTRACTION_MODEL=o4-mini
EXTRACTION_REASONING_EFFORT=high
EXTRACTION_MAX_TOKENS=32000

# Classification
CLASSIFICATION_MODEL=gpt-4.1-mini
THEME_MODEL=gpt-4o-mini

# Embeddings & Similarity
VOYAGE_MODEL=voyage-3-large
VOYAGE_BATCH_SIZE=1000
SIMILARITY_TOP_K=50
SIMILARITY_THRESHOLD=0.73
SAME_DOC_SIMILARITY_THRESHOLD=0.85

# Relationship Enhancement
ENHANCEMENT_MODEL=o4-mini
ENHANCEMENT_BATCH_SIZE=20

# Community Detection
COMMUNITY_MODEL=gpt-4o-mini

# Multi-Agent Exploration
EXPLORER_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Pipeline Control (Optional)
# -----------------------------------------------------------------------------

# Pause between API requests (seconds) to avoid rate limits
REQUEST_PAUSE_SEC=2.0

# Enable debug logging
DEBUG=false
